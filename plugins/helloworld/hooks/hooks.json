{
  "description": "Prints a [helloworld]-prefixed message to the user on each lifecycle event. The echo commands work in both bash and PowerShell.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "echo '{\"systemMessage\": \"[helloworld] hook: SessionStart\"}'" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "echo '{\"systemMessage\": \"[helloworld] hook: UserPromptSubmit\"}'" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "echo '{\"systemMessage\": \"[helloworld] hook: PreToolUse (Skill)\"}'" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^helloworld:greeter$",
        "hooks": [
          { "type": "command", "command": "echo '{\"systemMessage\": \"[helloworld] hook: SubagentStart (greeter)\"}'" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^helloworld:greeter$",
        "hooks": [
          { "type": "command", "command": "echo '{\"systemMessage\": \"[helloworld] hook: SubagentStop (greeter)\"}'" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "echo '{\"systemMessage\": \"[helloworld] hook: Stop\"}'" }
        ]
      }
    ]
  }
}
